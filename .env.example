# Пример переменных окружения. Скопируйте в .env или задайте в системе. Реальные ключи не коммитить.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Включить модель без интерфейса (удобно на Render): провайдер из списка выше и идентификатор модели.
AVATAR_LLM_PROVIDER=
AVATAR_LLM_MODEL=
# Токен Telegram-бота от @BotFather и токен Microsoft Graph (Outlook). Не коммитить.
TELEGRAM_BOT_TOKEN=
GRAPH_TOKEN=
# Если задан, изменение настроек и Telegram требует этот ключ (для публичного стенда).
AVATAR_ADMIN_KEY=
